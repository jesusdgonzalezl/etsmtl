---
import BaseLayout from '../layouts/BaseLayout.astro';
import site from '../config/site.json';
import { getCollection } from 'astro:content';

const publications = (await getCollection('publications')).filter((p) => p.data.featured).sort((a, b) => b.data.year - a.data.year).slice(0, 3);
const news = (await getCollection('news')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 3);
---
<BaseLayout>
  <section class="home-hero">
    <div class="shell hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">Aerospace engineering · ÉTS Montréal</p>
        <h1>{site.tagline}</h1>
        <p class="lede">{site.description}</p>
        <div class="button-row"><a class="button" href={`${import.meta.env.BASE_URL}research/`}>Explore our research</a><a class="text-link" href={`${import.meta.env.BASE_URL}opportunities/`}>Work with us →</a></div>
      </div>
      <div class="orbit-card" aria-label="Research themes">
        <span class="orbit orbit-one"></span><span class="orbit orbit-two"></span><span class="satellite-dot"></span>
        <p>Small satellites</p><p>Autonomous systems</p><p>Space power</p>
      </div>
    </div>
  </section>
  <section class="shell intro-grid section-space">
    <div><p class="eyebrow">Principal investigator</p><h2>{site.principalInvestigator.name}</h2><p>{site.principalInvestigator.title}, {site.principalInvestigator.department}</p><p class="small">{site.principalInvestigator.degrees}</p><a class="text-link" href={site.principalInvestigator.profileUrl}>View ÉTS profile ↗</a></div>
    {site.principalInvestigator.photo ? <img class="portrait" src={`${import.meta.env.BASE_URL}${site.principalInvestigator.photo.replace(/^\//, '')}`} alt={`Portrait of ${site.principalInvestigator.name}`} /> : <div class="portrait-placeholder" aria-label="Add the professor portrait in site configuration"><span>Photo</span><small>Add an image path in site.json</small></div>}
  </section>
  <section class="dark-section"><div class="shell section-space"><p class="eyebrow">What we investigate</p><h2>From component to mission</h2><div class="theme-grid"><article><span>01</span><h3>Space systems</h3><p>Mission-driven spacecraft design, qualification, and cyber-physical systems.</p></article><article><span>02</span><h3>Power & energy</h3><p>Reliable generation, conversion, storage, and distribution for small spacecraft.</p></article><article><span>03</span><h3>Intelligent autonomy</h3><p>Machine learning and control for resilient decision-making in space.</p></article></div></div></section>
  {publications.length > 0 && <section class="shell section-space"><div class="section-heading"><div><p class="eyebrow">Selected work</p><h2>Featured publications</h2></div><a class="text-link" href={`${import.meta.env.BASE_URL}publications/`}>All publications →</a></div><div class="stack-list">{publications.map((pub) => <article><div class="meta">{pub.data.year} · {pub.data.type}</div><h3>{pub.data.title}</h3><p>{pub.data.venue}</p></article>)}</div></section>}
  {news.length > 0 && <section class="muted-section"><div class="shell section-space"><div class="section-heading"><div><p class="eyebrow">Lab notes</p><h2>Latest news</h2></div><a class="text-link" href={`${import.meta.env.BASE_URL}news/`}>All news →</a></div><div class="card-grid">{news.map((item) => <article class="card"><p class="meta">{item.data.date.toLocaleDateString('en-CA', { year: 'numeric', month: 'long', day: 'numeric' })}</p><h3>{item.data.title}</h3><p>{item.data.summary}</p></article>)}</div></div></section>}
</BaseLayout>
