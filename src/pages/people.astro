---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import site from '../config/site.json';
import { getCollection, getEntry } from 'astro:content';

const page = await getEntry('pages', 'people');
if (!page) throw new Error('Missing people page');
const students = (await getCollection('students')).sort((a, b) => a.data.order - b.data.order);
---
<BaseLayout title={page.data.title}>
  <SectionHeader {...page.data} />
  <div class="shell section-space">
    <article class="person-card principal">
      {site.principalInvestigator.photo
        ? <img src={`${import.meta.env.BASE_URL}${site.principalInvestigator.photo.replace(/^\//, '')}`} alt={`Portrait of ${site.principalInvestigator.name}`} />
        : <div class="photo-placeholder" aria-hidden="true">JG</div>}
      <div>
        <p class="meta">Principal investigator</p>
        <h2>{site.principalInvestigator.name}</h2>
        <p>{site.principalInvestigator.title}, {site.principalInvestigator.department}</p>
        <a class="text-link" href={`mailto:${site.principalInvestigator.email}`}>Email</a>
      </div>
    </article>

    <h2 class="subheading">Current students</h2>
    <div class="people-grid">
      {students.filter((s) => s.data.status === 'current').map((student) =>
        <article class="person-card">
          {student.data.photo
            ? <img src={`${import.meta.env.BASE_URL}${student.data.photo.replace(/^\//, '')}`} alt={`Portrait of ${student.data.name}`} />
            : <div class="photo-placeholder" aria-hidden="true">{student.data.name.split(' ').map((name) => name[0]).join('').slice(0, 2)}</div>}
          <div>
            <p class="meta">{student.data.role}</p>
            <h3>{student.data.name}</h3>
            <p>{student.data.research}</p>
            {student.data.degree && <p class="small">{student.data.degree}</p>}
          </div>
        </article>
      )}
    </div>

    {students.some((s) => s.data.status === 'alumni') && <>
      <h2 class="subheading">Alumni</h2>
      <div class="people-grid">
        {students.filter((s) => s.data.status === 'alumni').map((student) =>
          <article class="person-card">
            <div class="photo-placeholder" aria-hidden="true">{student.data.name.split(' ').map((name) => name[0]).join('').slice(0, 2)}</div>
            <div><p class="meta">{student.data.role}</p><h3>{student.data.name}</h3><p>{student.data.research}</p></div>
          </article>
        )}
      </div>
    </>}
  </div>
</BaseLayout>
