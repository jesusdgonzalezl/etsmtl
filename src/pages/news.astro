---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import { getCollection, getEntry, render } from 'astro:content';
const page = await getEntry('pages', 'news');
if (!page) throw new Error('Missing news page');
const items = (await getCollection('news')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const renderedItems = await Promise.all(items.map(async (item) => ({ item, Content: (await render(item)).Content })));
---
<BaseLayout title={page.data.title}><SectionHeader {...page.data} /><div class="shell section-space card-grid">{renderedItems.map(({ item, Content }) => <article class="card news-card">{item.data.image && <img src={`${import.meta.env.BASE_URL}${item.data.image.replace(/^\//, '')}`} alt={item.data.imageAlt || ''} />}<p class="meta">{item.data.date.toLocaleDateString('en-CA', { year:'numeric', month:'long', day:'numeric' })}</p><h2>{item.data.title}</h2><p>{item.data.summary}</p><details><summary>Read more</summary><div class="prose"><Content /></div></details></article>)}</div></BaseLayout>
